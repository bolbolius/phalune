using Gtk 4.0;

Box ipc_pill {
  orientation: horizontal;
  spacing: 0;
  styles ["widget", "widget-pill", "widget-ipc"]

  Image ipc_icon {
    visible: false;
    pixel-size: 16;
  }

  LevelBar ipc_progress {
    visible: false;
    min-value: 0;
    max-value: 100;
    height-request: 6;
    styles ["ipc-progress"]
  }

  Label ipc_label {
    label: "";
    use-markup: true;
    halign: start;
    ellipsize: end;
    styles ["ipc-label"]
  }
}