using Gtk 4.0;

Overlay overlay_box {
  hexpand: true;
  vexpand: true;
  styles ["powermenu-overlay"]

  child: Box card {
    orientation: vertical;
    spacing: 16;
    halign: center;
    valign: center;
    width-request: 540;
    styles ["powermenu-card"]

    Box header_box {
      orientation: horizontal;
      spacing: 8;
      halign: center;

      Image header_icon {
        icon-name: "system-shutdown-symbolic";
        pixel-size: 20;
        accessible-role: presentation;
      }

      Label header_title {
        label: _("Power Menu");
        styles ["powermenu-title"]
      }
    }

    Grid actions_grid {
      column-spacing: 12;
      row-spacing: 12;
      column-homogeneous: true;
      row-homogeneous: true;
      styles ["powermenu-grid"]

      Button lock_button {
        tooltip-text: _("Lock Screen (1 or L)");
        styles ["powermenu-action-btn"]
        layout {
          row: 0;
          column: 0;
        }

        child: Box {
          orientation: vertical;
          spacing: 6;
          halign: center;
          valign: center;

          Image {
            icon-name: "system-lock-screen-symbolic";
            pixel-size: 32;
            accessible-role: presentation;
            styles ["powermenu-icon"]
          }

          Label {
            label: _("Lock");
            styles ["powermenu-action-title"]
          }

          Label {
            label: "1 / L";
            styles ["powermenu-key-hint"]
          }
        };
      }

      Button suspend_button {
        tooltip-text: _("Suspend / Sleep (2 or S)");
        styles ["powermenu-action-btn"]
        layout {
          row: 0;
          column: 1;
        }

        child: Box {
          orientation: vertical;
          spacing: 6;
          halign: center;
          valign: center;

          Image {
            icon-name: "weather-clear-night-symbolic";
            pixel-size: 32;
            accessible-role: presentation;
            styles ["powermenu-icon"]
          }

          Label {
            label: _("Suspend");
            styles ["powermenu-action-title"]
          }

          Label {
            label: "2 / S";
            styles ["powermenu-key-hint"]
          }
        };
      }

      Button hibernate_button {
        tooltip-text: _("Hibernate (6 or H)");
        styles ["powermenu-action-btn"]
        layout {
          row: 1;
          column: 2;
        }

        child: Box {
          orientation: vertical;
          spacing: 6;
          halign: center;
          valign: center;

          Image {
            icon-name: "drive-harddisk-symbolic";
            pixel-size: 32;
            accessible-role: presentation;
            styles ["powermenu-icon"]
          }

          Label {
            label: _("Hibernate");
            styles ["powermenu-action-title"]
          }

          Label {
            label: "6 / H";
            styles ["powermenu-key-hint"]
          }
        };
      }

      Button logout_button {
        tooltip-text: _("Log Out (3 or O)");
        styles ["powermenu-action-btn"]
        layout {
          row: 0;
          column: 2;
        }

        child: Box {
          orientation: vertical;
          spacing: 6;
          halign: center;
          valign: center;

          Image {
            icon-name: "system-log-out-symbolic";
            pixel-size: 32;
            accessible-role: presentation;
            styles ["powermenu-icon"]
          }

          Label {
            label: _("Log Out");
            styles ["powermenu-action-title"]
          }

          Label {
            label: "3 / O";
            styles ["powermenu-key-hint"]
          }
        };
      }

      Button reboot_button {
        tooltip-text: _("Restart (4 or R)");
        styles ["powermenu-action-btn"]
        layout {
          row: 1;
          column: 0;
        }

        child: Box {
          orientation: vertical;
          spacing: 6;
          halign: center;
          valign: center;

          Image {
            icon-name: "system-reboot-symbolic";
            pixel-size: 32;
            accessible-role: presentation;
            styles ["powermenu-icon"]
          }

          Label {
            label: _("Restart");
            styles ["powermenu-action-title"]
          }

          Label {
            label: "4 / R";
            styles ["powermenu-key-hint"]
          }
        };
      }

      Button shutdown_button {
        tooltip-text: _("Shut Down (5 or P)");
        styles ["powermenu-action-btn", "destructive-action"]
        layout {
          row: 1;
          column: 1;
        }

        child: Box {
          orientation: vertical;
          spacing: 6;
          halign: center;
          valign: center;

          Image {
            icon-name: "system-shutdown-symbolic";
            pixel-size: 32;
            accessible-role: presentation;
            styles ["powermenu-icon"]
          }

          Label {
            label: _("Shut Down");
            styles ["powermenu-action-title"]
          }

          Label {
            label: "5 / P";
            styles ["powermenu-key-hint"]
          }
        };
      }
    }

    Button cancel_button {
      label: _("Cancel");
      halign: center;
      styles ["powermenu-cancel-btn"]
    }
  };
}

